# Usada exclusivamente pelo backend Node e pelo comando `pnpm db:check`.
# Não informe este valor ao frontend nem versione um arquivo .env real.
DATABASE_URL=

# Usadas exclusivamente pelo backend Node para gerenciar o Supabase Storage.
# Nunca exponha SUPABASE_SERVICE_ROLE_KEY ao frontend nem versione um .env real.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
